# ==============================================================================
# DRISHTI Frontend - Environment Configuration
# ==============================================================================

# Backend API Base URL (points to Java Spring Boot backend context)
# Development Default: http://localhost:8080/api/v1
# Production Example: https://api.drishti.edu/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Application Environment Mode ('development' | 'production')
VITE_APP_ENV=development
